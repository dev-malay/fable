{
  "name": "cli",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "fable": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target bun",
    "dev": "bun --env-file=../../.env src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@fable/agent": "*",
    "@fable/protocol": "*"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}
